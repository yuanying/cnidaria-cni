# cnidaria's nftables table. Generated on every apply; edits here do not survive one.
#
# cnidaria owns this one table and nothing else in the ruleset, so the ruleset is never
# flushed and no rule anybody else installed, kube-proxy's included, is touched
# (ADR 0003). The two statements below add the table if it is not already there and
# then remove it, so that the one that follows goes in whether or not a previous apply
# left anything behind. nft runs the whole file as a single transaction, so the table
# is never half replaced.

table inet cnidaria
delete table inet cnidaria

table inet cnidaria {
	# This node's pod CIDRs (node.spec.podCIDRs)
	set node_pods_v4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}

	set node_pods_v6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8:1::/64 }
	}

	# Every node's pod CIDRs: traffic to these stays inside the cluster and is not masqueraded
	set cluster_pods_v4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24, 198.51.100.0/24 }
	}

	set cluster_pods_v6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8:1::/64, 2001:db8:2::/64 }
	}

	# Pods selected by at least one NetworkPolicy of that policyType; filled by the NetworkPolicy renderer
	set isolated_egress_v4 {
		type ipv4_addr
		elements = { 192.0.2.10, 192.0.2.11 }
	}

	set isolated_egress_v6 {
		type ipv6_addr
		elements = { 2001:db8:1::10, 2001:db8:1::11 }
	}

	set isolated_ingress_v4 {
		type ipv4_addr
		elements = { 192.0.2.10, 192.0.2.11 }
	}

	set isolated_ingress_v6 {
		type ipv6_addr
		elements = { 2001:db8:1::10, 2001:db8:1::11 }
	}

	set pods_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/c7bbee4d2bdd {
		type ipv4_addr
		elements = { 192.0.2.10 }
	}

	set pods_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/7fe1a5db0069 {
		type ipv6_addr
		elements = { 2001:db8:1::10 }
	}

	set peer_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/da5a7bc5ad9f {
		type ipv4_addr
		elements = { 192.0.2.11 }
	}

	set peer_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/8fbb5eead7cb {
		type ipv6_addr
		elements = { 2001:db8:1::11 }
	}

	set pods_default/client-out/v4 {
		type ipv4_addr
		elements = { 192.0.2.11 }
	}

	set pods_default/client-out/v6 {
		type ipv6_addr
		elements = { 2001:db8:1::11 }
	}

	set peer_default/client-out/eg0.0/v4 {
		type ipv4_addr
		elements = { 192.0.2.10, 198.51.100.10 }
	}

	set peer_default/client-out/eg0.0/v6 {
		type ipv6_addr
		elements = { 2001:db8:1::10, 2001:db8:2::10 }
	}

	set port_default/client-out/eg0.0.0/8080/v4 {
		type ipv4_addr
		elements = { 192.0.2.10, 198.51.100.10 }
	}

	set port_default/client-out/eg0.0.0/8080/v6 {
		type ipv6_addr
		elements = { 2001:db8:1::10, 2001:db8:2::10 }
	}

	set pods_default/deny-all/v4 {
		type ipv4_addr
		elements = { 192.0.2.10, 192.0.2.11 }
	}

	set pods_default/deny-all/v6 {
		type ipv6_addr
		elements = { 2001:db8:1::10, 2001:db8:1::11 }
	}

	set pods_default/web-in/v4 {
		type ipv4_addr
		elements = { 192.0.2.10 }
	}

	set pods_default/web-in/v6 {
		type ipv6_addr
		elements = { 2001:db8:1::10 }
	}

	set peer_default/web-in/in0.0/v4 {
		type ipv4_addr
		elements = { 192.0.2.11 }
	}

	set peer_default/web-in/in0.0/v6 {
		type ipv6_addr
		elements = { 2001:db8:1::11 }
	}

	set peer_default/web-in/in0.1/v4 {
		type ipv4_addr
		elements = { 198.51.100.11 }
	}

	set peer_default/web-in/in0.1/v6 {
		type ipv6_addr
		elements = { 2001:db8:2::11 }
	}

	# NetworkPolicy egress, keyed on the source pod (ADR 0003)
	chain egress {
		type filter hook forward priority filter; policy accept;
		ct state established,related counter accept comment "replies follow the connection"
		ip saddr @isolated_egress_v4 counter jump egress_dispatch comment "isolated for egress"
		ip6 saddr @isolated_egress_v6 counter jump egress_dispatch comment "isolated for egress"
	}

	# One jump per NetworkPolicy goes ahead of the drop
	chain egress_dispatch {
		ip saddr @pods_default/client-out/v4 counter jump egress_default/client-out comment "default/client-out"
		ip6 saddr @pods_default/client-out/v6 counter jump egress_default/client-out comment "default/client-out"
		ip saddr @pods_default/deny-all/v4 counter jump egress_default/deny-all comment "default/deny-all"
		ip6 saddr @pods_default/deny-all/v6 counter jump egress_default/deny-all comment "default/deny-all"
		counter drop comment "isolated pod, no policy accepted"
	}

	# NetworkPolicy ingress, keyed on the destination pod (ADR 0003)
	chain ingress {
		type filter hook forward priority filter + 1; policy accept;
		ct state established,related counter accept comment "replies follow the connection"
		ip daddr @isolated_ingress_v4 counter jump ingress_dispatch comment "isolated for ingress"
		ip6 daddr @isolated_ingress_v6 counter jump ingress_dispatch comment "isolated for ingress"
	}

	# One jump per NetworkPolicy goes ahead of the drop
	chain ingress_dispatch {
		ip daddr @pods_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/c7bbee4d2bdd counter jump ingress_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-lon/dec93ea8c6b4 comment "default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-na..."
		ip6 daddr @pods_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/7fe1a5db0069 counter jump ingress_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-lon/dec93ea8c6b4 comment "default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-na..."
		ip daddr @pods_default/deny-all/v4 counter jump ingress_default/deny-all comment "default/deny-all"
		ip6 daddr @pods_default/deny-all/v6 counter jump ingress_default/deny-all comment "default/deny-all"
		ip daddr @pods_default/web-in/v4 counter jump ingress_default/web-in comment "default/web-in"
		ip6 daddr @pods_default/web-in/v6 counter jump ingress_default/web-in comment "default/web-in"
		counter drop comment "isolated pod, no policy accepted"
	}

	# NodePolicy ingress, behind the safe rules a policy cannot remove (ADR 0004)
	chain input {
		type filter hook input priority filter; policy accept;
		ct state established,related counter accept comment "safe: replies to what the node opened"
		iifname "lo" counter accept comment "safe: loopback"
		icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } counter accept comment "safe: icmp"
		icmpv6 type { echo-request, destination-unreachable, time-exceeded, parameter-problem, packet-too-big, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } counter accept comment "safe: icmpv6"
		tcp dport 22 counter accept comment "safe: ssh"
		tcp dport 10250 counter accept comment "safe: kubelet"
		tcp dport 6443 counter accept comment "safe: apiserver"
		tcp dport 2379-2380 counter accept comment "safe: etcd"
		tcp dport 30000-32767 counter accept comment "safe: nodeport"
		udp dport 30000-32767 counter accept comment "safe: nodeport"
	}

	# NodePolicy egress, behind the safe rules a policy cannot remove (ADR 0004)
	chain output {
		type filter hook output priority filter; policy accept;
		ct state established,related counter accept comment "safe: replies to what the node opened"
		oifname "lo" counter accept comment "safe: loopback"
		icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } counter accept comment "safe: icmp"
		icmpv6 type { echo-request, destination-unreachable, time-exceeded, parameter-problem, packet-too-big, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } counter accept comment "safe: icmpv6"
		tcp dport 6443 counter accept comment "safe: apiserver"
		tcp dport 2379-2380 counter accept comment "safe: etcd"
		tcp dport 10250 counter accept comment "safe: kubelet"
		tcp dport 53 counter accept comment "safe: dns"
		udp dport 53 counter accept comment "safe: dns"
		ip daddr @node_pods_v4 counter accept comment "safe: this node's pods"
		ip6 daddr @node_pods_v6 counter accept comment "safe: this node's pods"
	}

	# Masquerade for pod traffic leaving the cluster's pod CIDRs (ADR 0001, ADR 0003)
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr @node_pods_v4 ip daddr != @cluster_pods_v4 counter masquerade comment "pod traffic leaving the cluster"
		ip6 saddr @node_pods_v6 ip6 daddr != @cluster_pods_v6 counter masquerade comment "pod traffic leaving the cluster"
	}

	# NetworkPolicy default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-, Ingress
	chain ingress_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-lon/dec93ea8c6b4 {
		ip saddr @peer_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/da5a7bc5ad9f counter accept comment "default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-na..."
		ip6 saddr @peer_default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-p/8fbb5eead7cb counter accept comment "default/a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-name-a-very-long-policy-na..."
	}

	# NetworkPolicy default/client-out, Egress
	chain egress_default/client-out {
		ip daddr @peer_default/client-out/eg0.0/v4 ip daddr @port_default/client-out/eg0.0.0/8080/v4 tcp dport 8080 counter accept comment "default/client-out"
		ip6 daddr @peer_default/client-out/eg0.0/v6 ip6 daddr @port_default/client-out/eg0.0.0/8080/v6 tcp dport 8080 counter accept comment "default/client-out"
		udp dport 53 counter accept comment "default/client-out"
	}

	# NetworkPolicy default/deny-all, Ingress
	chain ingress_default/deny-all {
	}

	# NetworkPolicy default/deny-all, Egress
	chain egress_default/deny-all {
	}

	# NetworkPolicy default/web-in, Ingress
	chain ingress_default/web-in {
		ip saddr @peer_default/web-in/in0.0/v4 tcp dport 80 counter accept comment "default/web-in"
		ip saddr @peer_default/web-in/in0.0/v4 tcp dport 8000-8100 counter accept comment "default/web-in"
		ip6 saddr @peer_default/web-in/in0.0/v6 tcp dport 80 counter accept comment "default/web-in"
		ip6 saddr @peer_default/web-in/in0.0/v6 tcp dport 8000-8100 counter accept comment "default/web-in"
		ip saddr @peer_default/web-in/in0.1/v4 tcp dport 80 counter accept comment "default/web-in"
		ip saddr @peer_default/web-in/in0.1/v4 tcp dport 8000-8100 counter accept comment "default/web-in"
		ip6 saddr @peer_default/web-in/in0.1/v6 tcp dport 80 counter accept comment "default/web-in"
		ip6 saddr @peer_default/web-in/in0.1/v6 tcp dport 8000-8100 counter accept comment "default/web-in"
		ip saddr 203.0.113.0/24 ip saddr != { 203.0.113.16/28, 203.0.113.128/25 } counter accept comment "default/web-in"
	}
}
