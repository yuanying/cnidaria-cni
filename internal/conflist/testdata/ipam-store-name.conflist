{
  "cniVersion": "1.0.0",
  "name": "cnidaria",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "cni0",
      "isDefaultGateway": true,
      "hairpinMode": true,
      "mtu": 1500,
      "ipam": {
        "type": "host-local",
        "name": "cbr0",
        "ranges": [
          [
            {
              "subnet": "192.0.2.0/24"
            }
          ],
          [
            {
              "subnet": "2001:db8:1::/64"
            }
          ]
        ]
      }
    },
    {
      "type": "portmap",
      "capabilities": {
        "portMappings": true
      }
    }
  ]
}
